{
  "sections": {
    "breadcrumbs": {
      "type": "breadcrumbs",
      "settings": {}
    },
    "page": {
      "type": "product-page__product",
      "blocks": {
        "ppTitle": {
          "type": "productPageTitle",
          "settings": {
            "noMargin": true,
            "color": "rgba(0,0,0,0)",
            "fontFamily": "title",
            "fontSize": "large"
          }
        },
        "review_stars": {
          "type": "productPageReviewStars",
          "settings": {
            "noMargin": false
          }
        },
        "ppPrice": {
          "type": "productPagePrice",
          "settings": {
            "noMargin": false,
            "color": "rgba(0,0,0,0)",
            "newPriceColor": "#ea580c",
            "oldPriceColor": "#8c918e",
            "fontFamily": "base",
            "fontSize": "medium"
          }
        },
        "ppSwatch": {
          "type": "productPageSwatch",
          "settings": {
            "noMargin": false
          }
        },
        "ppATC": {
          "type": "productPageATC",
          "settings": {
            "noMargin": false,
            "stickyATC": "scroll"
          }
        },
        "shop_pay": {
          "type": "productPageShopPay",
          "settings": {}
        },
        "tab_synopsis": {
          "type": "productPageTab",
          "settings": {
            "showInline": false,
            "heading": "About",
            "content": "description",
            "metafieldNS": "global",
            "metafieldKey": "",
            "page": "",
            "customContent": "<p>150 pages. Hand-drawn diagrams. Verified clearances. The one resource on every designer's desk.</p>"
          }
        },
        "tab_reviews": {
          "type": "productPageTab",
          "settings": {
            "showInline": false,
            "heading": "Reviews",
            "content": "reviews",
            "metafieldNS": "global",
            "metafieldKey": "",
            "page": "",
            "customContent": "<p>Add custom content here!</p>"
          }
        },
        "trust_badges": {
          "type": "productPageBadge",
          "settings": {
            "noMargin": false,
            "imageAlt": ""
          }
        }
      },
      "block_order": [
        "ppTitle",
        "review_stars",
        "ppPrice",
        "ppSwatch",
        "ppATC",
        "shop_pay",
        "tab_synopsis",
        "tab_reviews",
        "trust_badges"
      ],
      "settings": {
        "view": "default",
        "layout": "max-width",
        "galleryStyle": "default",
        "galleryPosition": "left",
        "autoZoom": true,
        "autoChange": true,
        "galleryImageFit": "contain",
        "galleryImageGap": 16,
        "productNavigation": true,
        "productMainImageSize": "full_ratio",
        "imageSticky": true,
        "imageStickyPosition": 80
      }
    },
    "kitchenind_details": {
      "type": "section__kitchenind-landing",
      "settings": {}
    },
    "inline_upsell": {
      "type": "api__upsell--inline",
      "blocks": {
        "companion_books": {
          "type": "priceSpecific",
          "settings": {
            "conditionType": "lt",
            "condition": "50",
            "upsellProduct1": "living-room-design-book",
            "upsellProduct2": "bedroom-design-book",
            "upsellProduct3": "washroom-design-book",
            "heading": "Frequently Paired With This Book",
            "subheading": "Complete your design collection"
          }
        }
      },
      "block_order": [
        "companion_books"
      ],
      "settings": {}
    },
    "recommended": {
      "type": "product-page__recommended",
      "settings": {
        "enabled": true,
        "personalizedOffers": true,
        "layout": "max-width",
        "heading": "Readers Also Loved",
        "subheading": "Curated Recommendations",
        "subheadingPosition": "above",
        "textAlignment": "center",
        "defaultCollection": ""
      }
    }
  },
  "order": [
    "breadcrumbs",
    "page",
    "kitchenind_details",
    "inline_upsell",
    "recommended"
  ]
}