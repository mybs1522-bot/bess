{
  "sections": {
    "breadcrumbs": {
      "type": "breadcrumbs",
      "settings": {}
    },
    "page": {
      "type": "product-page__product",
      "blocks": {
        "ppTitle": {
          "type": "productPageTitle",
          "settings": {
            "noMargin": true,
            "color": "rgba(0,0,0,0)",
            "fontFamily": "title",
            "fontSize": "large"
          }
        },
        "review_stars": {
          "type": "productPageReviewStars",
          "settings": {
            "noMargin": false
          }
        },
        "ppPrice": {
          "type": "productPagePrice",
          "settings": {
            "noMargin": false,
            "color": "rgba(0,0,0,0)",
            "newPriceColor": "#138867",
            "oldPriceColor": "#8c918e",
            "fontFamily": "base",
            "fontSize": "medium"
          }
        },
        "ppSwatch": {
          "type": "productPageSwatch",
          "settings": {
            "noMargin": false
          }
        },
        "ppATC": {
          "type": "productPageATC",
          "settings": {
            "noMargin": false,
            "stickyATC": "scroll"
          }
        },
        "shop_pay": {
          "type": "productPageShopPay",
          "settings": {}
        },
        "delivery_estimate": {
          "type": "productPageLDelivery",
          "settings": {
            "noMargin": false,
            "icon": "",
            "iconColor": "#138867",
            "text": "<p><strong>Fast Dispatch:</strong> Delivered within %start%-%end% business days in protective packaging.</p>",
            "start": "2",
            "end": "4",
            "textColor": "#474747"
          }
        },
        "tab_synopsis": {
          "type": "productPageTab",
          "settings": {
            "showInline": false,
            "heading": "Synopsis",
            "content": "description"
          }
        },
        "tab_specs": {
          "type": "productPageTab",
          "settings": {
            "showInline": false,
            "heading": "Book Specifications",
            "content": "custom",
            "customContent": "<div style=\"line-height: 1.8; font-size: 14px;\"><p><strong>Format Options:</strong> Hardcover, Paperback, eBook, Audiobook</p><p><strong>Language:</strong> English</p><p><strong>Condition:</strong> Brand New / First Edition</p><p><strong>Guarantee:</strong> 30-Day Hassle-Free Returns</p></div>"
          }
        },
        "tab_author": {
          "type": "productPageTab",
          "settings": {
            "showInline": false,
            "heading": "About the Author",
            "content": "custom",
            "customContent": "<div style=\"line-height: 1.8; font-size: 14px;\"><p>Discover the inspiration and craft behind the writing. Full biographical notes and author interview highlights.</p></div>"
          }
        },
        "tab_reviews": {
          "type": "productPageTab",
          "settings": {
            "showInline": false,
            "heading": "Reader Reviews",
            "content": "reviews"
          }
        },
        "trust_badges": {
          "type": "productPageBadge",
          "settings": {
            "noMargin": false,
            "badge": "shopify://shop_images/2adge11.png"
          }
        },
        "social_share": {
          "type": "productPageShare",
          "settings": {
            "noMargin": false
          }
        }
      },
      "block_order": [
        "ppTitle",
        "review_stars",
        "ppPrice",
        "ppSwatch",
        "ppATC",
        "shop_pay",
        "delivery_estimate",
        "tab_synopsis",
        "tab_specs",
        "tab_author",
        "tab_reviews",
        "trust_badges",
        "social_share"
      ],
      "settings": {
        "view": "default",
        "layout": "max-width",
        "galleryStyle": "default",
        "galleryPosition": "left",
        "autoZoom": true,
        "autoChange": true,
        "galleryImageFit": "contain",
        "galleryImageGap": 16,
        "productNavigation": true,
        "productMainImageSize": "full_ratio",
        "imageSticky": true,
        "imageStickyPosition": 80
      }
    },
    "inline_upsell": {
      "type": "api__upsell--inline",
      "blocks": {
        "companion_books": {
          "type": "priceSpecific",
          "settings": {
            "conditionType": "lt",
            "condition": "50",
            "upsellProduct1": "1-000-perfect-weekends-great-getaways-around-the-globe",
            "upsellProduct2": "23-things-they-dont-tell-you-about-capitalism",
            "upsellProduct3": "",
            "heading": "Frequently Paired With This Book",
            "subheading": "Complete your collection"
          }
        }
      },
      "block_order": [
        "companion_books"
      ],
      "settings": {}
    },
    "recommended": {
      "type": "product-page__recommended",
      "settings": {
        "enabled": true,
        "personalizedOffers": true,
        "layout": "max-width",
        "heading": "Readers Also Loved",
        "subheading": "Curated Recommendations",
        "subheadingPosition": "above",
        "textAlignment": "center",
        "defaultCollection": ""
      }
    }
  },
  "order": [
    "breadcrumbs",
    "page",
    "inline_upsell",
    "recommended"
  ]
}