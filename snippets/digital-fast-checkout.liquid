{% comment %}
  Digital Fast Checkout Modal & Auto-Prefill Engine
  - Hides all physical & billing address fields from frontend
  - Only requires customer Email for digital PDF delivery
  - Auto-prefills valid dummy billing address data into Shopify Checkout permalinks
{% endcomment %}

<div id="digital-checkout-modal" class="digital-checkout-overlay" style="display: none;">
  <div class="digital-checkout-card">
    <button type="button" class="digital-checkout-close" onclick="closeDigitalCheckoutModal()" aria-label="Close modal">&times;</button>
    
    <div class="digital-checkout-header">
      <div class="digital-checkout-icon">📚</div>
      <h3 class="digital-checkout-title">Instant Digital Access</h3>
      <p class="digital-checkout-subtitle">Enter your email to receive your Kitchen Design Book PDF & blueprint files immediately:</p>
    </div>

    <form id="digital-checkout-form" onsubmit="handleDigitalCheckoutSubmit(event)">
      <div class="digital-checkout-field">
        <label for="digital-checkout-email" class="digital-checkout-label">Email Address (for instant book delivery)</label>
        <div class="digital-checkout-input-wrap">
          <svg class="digital-checkout-input-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
            <polyline points="22,6 12,13 2,6"></polyline>
          </svg>
          <input 
            type="email" 
            id="digital-checkout-email" 
            class="digital-checkout-input" 
            placeholder="yourname@gmail.com" 
            required 
            autocomplete="email"
          />
        </div>
      </div>

      <button type="submit" id="digital-checkout-submit-btn" class="digital-checkout-btn">
        <span>Proceed to Secure Payment</span>
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </button>

      <div style="text-align: center; margin-top: 12px;">
        <a href="javascript:void(0)" onclick="handleDirectCheckoutWithoutEmail()" style="font-size: 12px; color: #6b7280; text-decoration: underline;">
          Or enter email directly on checkout page &rarr;
        </a>
      </div>

      <div class="digital-checkout-badges">
        <span class="digital-badge">🔒 256-bit Encrypted</span>
        <span class="digital-badge">⚡ Instant PDF Download</span>
        <span class="digital-badge">🛡️ 100% Guarantee</span>
      </div>

      <p class="digital-checkout-note">
        Digital product: Zero physical shipping or billing address required on frontend. Payment via UPI, GPay, PhonePe, Cards, or Netbanking.
      </p>
    </form>
  </div>
</div>

<style>
.digital-checkout-overlay {
  position: fixed;
  inset: 0;
  z-index: 999999;
  background: rgba(9, 9, 11, 0.75);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16px;
  animation: digitalFadeIn 0.2s ease-out;
}
@keyframes digitalFadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}
.digital-checkout-card {
  background: #ffffff;
  border-radius: 24px;
  max-width: 460px;
  width: 100%;
  padding: 32px 28px;
  position: relative;
  box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.35), 0 0 0 1px rgba(229, 231, 235, 0.8);
  font-family: 'Inter', system-ui, -apple-system, sans-serif;
  color: #111827;
  text-align: left;
  animation: digitalSlideUp 0.25s cubic-bezier(0.16, 1, 0.3, 1);
}
@keyframes digitalSlideUp {
  from { transform: translateY(20px) scale(0.97); opacity: 0; }
  to { transform: translateY(0) scale(1); opacity: 1; }
}
.digital-checkout-close {
  position: absolute;
  top: 16px;
  right: 18px;
  background: #f3f4f6;
  border: none;
  border-radius: 50%;
  width: 32px;
  height: 32px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20px;
  cursor: pointer;
  color: #4b5563;
  transition: all 0.15s ease;
}
.digital-checkout-close:hover {
  background: #e5e7eb;
  color: #111827;
  transform: rotate(90deg);
}
.digital-checkout-header {
  text-align: center;
  margin-bottom: 24px;
}
.digital-checkout-icon {
  font-size: 38px;
  margin-bottom: 10px;
  display: inline-block;
  background: #fff7ed;
  width: 68px;
  height: 68px;
  line-height: 68px;
  border-radius: 20px;
  border: 1px solid #fed7aa;
}
.digital-checkout-title {
  font-family: 'Space Grotesk', sans-serif !important;
  font-size: 22px !important;
  font-weight: 800 !important;
  color: #09090b !important;
  margin: 0 0 6px 0 !important;
  letter-spacing: -0.02em;
}
.digital-checkout-subtitle {
  font-size: 13.5px;
  color: #6b7280;
  line-height: 1.5;
  margin: 0;
}
.digital-checkout-field {
  margin-bottom: 20px;
}
.digital-checkout-label {
  display: block;
  font-size: 12px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  color: #374151;
  margin-bottom: 8px;
}
.digital-checkout-input-wrap {
  position: relative;
  display: flex;
  align-items: center;
}
.digital-checkout-input-icon {
  position: absolute;
  left: 14px;
  color: #9ca3af;
  pointer-events: none;
}
.digital-checkout-input {
  width: 100% !important;
  padding: 14px 14px 14px 42px !important;
  border: 2px solid #e5e7eb !important;
  border-radius: 14px !important;
  font-size: 15px !important;
  font-family: inherit !important;
  color: #111827 !important;
  background: #f9fafb !important;
  transition: all 0.2s ease !important;
  box-sizing: border-box !important;
}
.digital-checkout-input:focus {
  outline: none !important;
  border-color: #ea580c !important;
  background: #ffffff !important;
  box-shadow: 0 0 0 4px rgba(234, 88, 12, 0.12) !important;
}
.digital-checkout-btn {
  width: 100%;
  background: linear-gradient(135deg, #09090b 0%, #1f2937 100%);
  color: #ffffff !important;
  border: none;
  border-radius: 14px;
  padding: 16px 24px;
  font-size: 15px;
  font-weight: 700;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  transition: all 0.2s ease;
  box-shadow: 0 10px 20px rgba(0, 0, 0, 0.15);
}
.digital-checkout-btn:hover {
  background: #ea580c;
  transform: translateY(-2px);
  box-shadow: 0 12px 24px rgba(234, 88, 12, 0.3);
}
.digital-checkout-btn:active {
  transform: translateY(0);
}
.digital-checkout-badges {
  display: flex;
  justify-content: center;
  gap: 12px;
  margin-top: 18px;
  flex-wrap: wrap;
}
.digital-badge {
  font-size: 11px;
  color: #4b5563;
  background: #f3f4f6;
  padding: 4px 10px;
  border-radius: 20px;
  font-weight: 600;
}
.digital-checkout-note {
  font-size: 11.5px;
  color: #9ca3af;
  text-align: center;
  margin: 14px 0 0 0;
  line-height: 1.4;
}
</style>

<script>
(function() {
  // Configured default digital billing address (prefilled behind the scenes)
  const PREFILL_ADDRESS = {
    first_name: "Digital",
    last_name: "Customer",
    address1: "Flat 101 Digital Residency",
    city: "New Delhi",
    province: "Delhi",
    zip: "110001",
    country: "IN"
  };

  let pendingVariantId = null;

  window.openDigitalCheckout = function(variantId = null) {
    if (!variantId) {
      const variantInput = document.querySelector('[name="id"], [data-bstr-variant-input]');
      if (variantInput && variantInput.value) {
        variantId = variantInput.value;
      }
    }
    pendingVariantId = variantId;

    const modal = document.getElementById("digital-checkout-modal");
    if (modal) {
      modal.style.display = "flex";
      setTimeout(() => {
        const input = document.getElementById("digital-checkout-email");
        if (input) input.focus();
      }, 100);
    }
  };

  window.closeDigitalCheckoutModal = function() {
    const modal = document.getElementById("digital-checkout-modal");
    if (modal) modal.style.display = "none";
  };

  document.addEventListener("click", function(e) {
    const modal = document.getElementById("digital-checkout-modal");
    if (modal && e.target === modal) {
      closeDigitalCheckoutModal();
    }
  });

  window.buildDigitalCheckoutUrl = function(items, email = "") {
    const params = new URLSearchParams();
    if (email) {
      params.set("checkout[email]", email);
    }
    params.set("checkout[billing_address][first_name]", PREFILL_ADDRESS.first_name);
    params.set("checkout[billing_address][last_name]", PREFILL_ADDRESS.last_name);
    params.set("checkout[billing_address][address1]", PREFILL_ADDRESS.address1);
    params.set("checkout[billing_address][city]", PREFILL_ADDRESS.city);
    params.set("checkout[billing_address][province]", PREFILL_ADDRESS.province);
    params.set("checkout[billing_address][zip]", PREFILL_ADDRESS.zip);
    params.set("checkout[billing_address][country]", PREFILL_ADDRESS.country);

    let itemsStr = "";
    if (Array.isArray(items)) {
      itemsStr = items.map(i => (i.id || i.variant_id) + ":" + (i.quantity || 1)).join(",");
    } else if (items) {
      itemsStr = items + ":1";
    }

    if (!itemsStr) {
      return "/checkout?" + params.toString();
    }
    return "/cart/" + itemsStr + "?" + params.toString();
  };

  window.handleDigitalCheckoutSubmit = function(e) {
    e.preventDefault();
    const emailInput = document.getElementById("digital-checkout-email");
    const email = emailInput ? emailInput.value.trim() : "";
    const submitBtn = document.getElementById("digital-checkout-submit-btn");

    if (!email) return;

    if (submitBtn) {
      submitBtn.disabled = true;
      submitBtn.innerHTML = "<span>Redirecting to Payment...</span>";
    }

    if (pendingVariantId) {
      window.location.href = buildDigitalCheckoutUrl(pendingVariantId, email);
      return;
    }

    fetch("/cart.js")
      .then(r => r.json())
      .then(cart => {
        if (cart.items && cart.items.length > 0) {
          const items = cart.items.map(i => ({ id: i.variant_id, quantity: i.quantity }));
          window.location.href = buildDigitalCheckoutUrl(items, email);
        } else {
          const variantInput = document.querySelector('[name="id"], [data-bstr-variant-input]');
          const fallbackVarId = variantInput ? variantInput.value : "";
          window.location.href = buildDigitalCheckoutUrl(fallbackVarId, email);
        }
      })
      .catch(() => {
        window.location.href = buildDigitalCheckoutUrl(pendingVariantId, email);
      });
  };

  window.handleDirectCheckoutWithoutEmail = function() {
    if (pendingVariantId) {
      window.location.href = buildDigitalCheckoutUrl(pendingVariantId);
      return;
    }
    fetch('/cart.js')
      .then(r => r.json())
      .then(cart => {
        if (cart.items && cart.items.length > 0) {
          const items = cart.items.map(i => ({ id: i.variant_id, quantity: i.quantity }));
          window.location.href = buildDigitalCheckoutUrl(items);
        } else {
          const variantInput = document.querySelector('[name="id"], [data-bstr-variant-input]');
          const fallbackVarId = variantInput ? variantInput.value : '';
          window.location.href = buildDigitalCheckoutUrl(fallbackVarId);
        }
      })
      .catch(() => {
        window.location.href = buildDigitalCheckoutUrl(pendingVariantId);
      });
  };

  document.addEventListener("click", function(e) {
    const checkoutLink = e.target.closest('a[href*="/checkout"], [data-digital-checkout]');
    if (checkoutLink) {
      e.preventDefault();
      e.stopPropagation();
      openDigitalCheckout();
      return;
    }

    const checkoutBtn = e.target.closest('button[name="checkout"], input[name="checkout"]');
    if (checkoutBtn) {
      e.preventDefault();
      e.stopPropagation();
      openDigitalCheckout();
      return;
    }
  }, true);

})();
</script>