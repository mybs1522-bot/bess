{% if block.settings.stickyATC == "scroll" %}
<script>
document.addEventListener('booster:initialized', (e)=>{
    let bt = event.detail.BoosterTheme
    let sticky = document.querySelector('.sticky--mobile:not([data-bstr-initd])')
    if(!sticky) return
    sticky.dataset.bstrInitd = "true"
    document.addEventListener('scroll', debounce(()=>{
        if(window.innerWidth > 768) return
        let patc = document.querySelector('.product__atc')
        if(!patc) return
        if(patc.offsetTop + patc.clientHeight < window.scrollY){
            sticky.classList.remove('hide')
        } else {
            sticky.classList.add('hide')
            sticky.classList.add('sticky--closed')
        }
    }, 150))
})
</script>
{% elsif block.settings.stickyATC == "always" %}
<style>
@media screen and (max-width: 767px){
    .sticky--mobile {
        display: block !important;
    }
}
</style>
{% endif %}

<style>
.button--buy-now {
  cursor: pointer;
  transition: all 0.2s ease;
}
.button--buy-now:hover {
  transform: translateY(-1px);
}
</style>

<script>
/* Direct 1-Click Buy Now to Checkout */
window.executeDirectBuyNow = function(e, btn) {
  if (e) {
    e.preventDefault();
    e.stopPropagation();
  }
  if (!btn) btn = (e && e.currentTarget) ? e.currentTarget : document.querySelector('[data-buy-button]');
  if (btn) {
    btn.style.opacity = '0.85';
    btn.style.pointerEvents = 'none';
    const textSpan = btn.querySelector('[data-button-text]');
    if (textSpan) textSpan.textContent = 'Redirecting to Checkout...';
  }

  let variantId = null;
  let qty = 1;

  const form = btn ? btn.closest('form') : document.querySelector('form[action*="/cart/add"]');
  if (form) {
    const varInp = form.querySelector('[name="id"]');
    if (varInp && varInp.value) variantId = varInp.value;
    const qtyInp = form.querySelector('[name="quantity"]');
    if (qtyInp && qtyInp.value) qty = parseInt(qtyInp.value, 10) || 1;
  }
  if (!variantId) {
    const varInp = document.querySelector('[data-bstr-variant-input]') || document.querySelector('input[name="id"]');
    if (varInp && varInp.value) variantId = varInp.value;
  }
  if (!variantId) {
    variantId = '{{ product.selected_or_first_available_variant.id }}';
  }

  fetch('/cart/add.js', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ id: variantId, quantity: qty })
  })
  .then(function() {
    window.location.href = '/checkout';
  })
  .catch(function(err) {
    console.error('Checkout redirect fallback:', err);
    window.location.href = '/checkout';
  });
};
</script>