<div class="product__atc {% if block.settings.noMargin or noMargin %}margin__bottom--reduced{%endif-%}" {{block.shopify_attributes}}>
    {% if product.available %}
        <input style="display: none;" name="id" data-bstr-variant-input="{{product.id}}" value="{{product.selected_or_first_available_variant.id}}">
        <!-- Urgency Countdown Timer Directly Above Buy Now Button -->
        <div class="arch-atc-timer-box">
          <div class="arch-atc-timer-inner">
            <div class="arch-atc-timer-left">
              <span class="arch-timer-pulse-dot"></span>
              <span class="arch-atc-timer-label">Flash Offer Ends In:</span>
            </div>
            <div class="arch-atc-timer-right">
              <span class="arch-atc-clock-unit"><strong id="mainAtcHours">07</strong><small>H</small></span><!--
              --><span class="arch-atc-clock-sep">:</span><!--
              --><span class="arch-atc-clock-unit"><strong id="mainAtcMinutes">37</strong><small>M</small></span><!--
              --><span class="arch-atc-clock-sep">:</span><!--
              --><span class="arch-atc-clock-unit"><strong id="mainAtcSeconds">40</strong><small>S</small></span>
            </div>
          </div>
        </div>

        <div class="product__atc-row">
            <div class="quantity--input">
                <button class="quantity--input__button quantity--input__incr" onclick="BoosterTheme.cart.quantityHandler(event, false, false)">-</button>
                <input {% if product.selected_or_first_available_variant.inventory_policy != "continue" %}max="{{ product.selected_or_first_available_variant.inventory_quantity }}"{% endif %} class="quantity--input__input" value="1" data-qty-input type="number" name="quantity" min="1" aria-label="Quantity input"><!--
                --><button class="quantity--input__button quantity--input__decr" onclick="BoosterTheme.cart.quantityHandler(event, true, false)">+</button>
            </div>
            {% render 'add-to-cart-button', type: 'secondary', price: product.price, text: 'Buy Now', is_buy_now: true %}
        </div>
        {% if settings.dynamicCheckout %}
            <div data-dynamic-button="{{product.id}}"  class="col-12 no-gap checkout--dynamic">
            {{ form | payment_button }}
            {% comment %} {% if additional_checkout_buttons %}
                {{ content_for_additional_checkout_buttons }}
            {% endif %} {% endcomment %}
            </div>
            <div class="product__shoppay-installments" style="margin-top: 8px; margin-bottom: 2px; text-align: center; width: 100%;">
              {{ form | payment_terms }}
            </div>
        {% endif %}
    {% else %}
        {% render 'sold-out-button', disabled: 'disabled' %}
    {%endif%}
</div>

<style>
/* Remove More Payment Options */
.shopify-payment-button__more-options,
[data-testid="MorePaymentOptionsButton"],
shopify-accelerated-checkout .shopify-payment-button__more-options,
.shopify-payment-button .shopify-payment-button__more-options,
.shopify-payment-button__skeleton.shopify-payment-button__more-options {
  display: none !important;
  visibility: hidden !important;
  height: 0 !important;
  min-height: 0 !important;
  margin: 0 !important;
  padding: 0 !important;
  pointer-events: none !important;
  opacity: 0 !important;
}

/* Pay in installments directly under Buy with Shop */
.product__shoppay-installments {
  white-space: nowrap !important;
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  width: 100% !important;
  margin: 8px 0 4px 0 !important;
  text-align: center !important;
}
.product__shoppay-installments shopify-payment-terms {
  display: inline-flex !important;
  align-items: center !important;
  justify-content: center !important;
  white-space: nowrap !important;
  font-size: clamp(10.5px, 3.2vw, 13px) !important;
  margin: 0 auto !important;
}
</style>

<script>
(function() {
  function forceSingleLinePaymentTerms() {
    var pts = document.querySelectorAll('shopify-payment-terms');
    pts.forEach(function(pt) {
      if (pt && pt.shadowRoot) {
        if (!pt.shadowRoot.querySelector('#single-line-shop-pay-css')) {
          var style = document.createElement('style');
          style.id = 'single-line-shop-pay-css';
          style.textContent = `
            #shopify-installments,
            #shopify-installments p {
              white-space: nowrap !important;
              display: inline-flex !important;
              align-items: center !important;
              justify-content: center !important;
              flex-wrap: nowrap !important;
              font-size: clamp(10px, 3.1vw, 13px) !important;
              letter-spacing: -0.015em !important;
              line-height: 1.2 !important;
              margin: 0 auto !important;
            }
            #shopify-installments-content {
              white-space: nowrap !important;
              flex-shrink: 0 !important;
            }
            #shopify-installments-cta {
              display: inline-flex !important;
              align-items: center !important;
              white-space: nowrap !important;
              flex-shrink: 0 !important;
              margin-left: 3px !important;
            }
            @media (max-width: 480px) {
              #shopify-installments,
              #shopify-installments p {
                font-size: 11px !important;
                letter-spacing: -0.025em !important;
              }
            }
            @media (max-width: 360px) {
              #shopify-installments,
              #shopify-installments p {
                font-size: 9.6px !important;
                letter-spacing: -0.03em !important;
              }
            }
          `;
          pt.shadowRoot.appendChild(style);
        }
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', forceSingleLinePaymentTerms);
  } else {
    forceSingleLinePaymentTerms();
  }

  var observer = new MutationObserver(forceSingleLinePaymentTerms);
  observer.observe(document.body, { childList: true, subtree: true });

  var attempts = 0;
  var timer = setInterval(function() {
    forceSingleLinePaymentTerms();
    attempts++;
    if (attempts > 30) clearInterval(timer);
  }, 150);
})();
</script>

