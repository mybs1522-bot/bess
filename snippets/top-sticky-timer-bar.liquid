<script>
function handleTopTimerClick(e) {
  var atc = document.querySelector('.product__atc') || 
            document.querySelector('[data-dynamic-button]') || 
            document.querySelector('form[action*="/cart/add"]');
  if (atc) {
    atc.scrollIntoView({ behavior: 'smooth', block: 'center' });
  } else {
    window.location.href = '/products/6-books-for-interior-exterior-design';
  }
}

(function() {
  const DURATION_SECONDS = 7 * 3600 + 37 * 60 + 40;
  const STORAGE_KEY = 'arch_evergreen_deadline_v1';

  function initTopTimer() {
    let stored = localStorage.getItem(STORAGE_KEY);
    const now = Date.now();
    let deadline;
    if (!stored || isNaN(parseInt(stored, 10)) || parseInt(stored, 10) <= now) {
      deadline = now + DURATION_SECONDS * 1000;
      localStorage.setItem(STORAGE_KEY, deadline);
    } else {
      deadline = parseInt(stored, 10);
    }

    const diff = Math.max(0, Math.floor((deadline - now) / 1000));
    const h = Math.floor(diff / 3600);
    const m = Math.floor((diff % 3600) / 60);
    const s = diff % 60;
    const pad = n => (n < 10 ? '0' + n : '' + n);

    const elH = document.getElementById('topStickyHours');
    const elM = document.getElementById('topStickyMinutes');
    const elS = document.getElementById('topStickySeconds');
    if (elH) elH.textContent = pad(h);
    if (elM) elM.textContent = pad(m);
    if (elS) elS.textContent = pad(s);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initTopTimer);
  } else {
    initTopTimer();
  }
  setInterval(initTopTimer, 1000);
})();
</script>
