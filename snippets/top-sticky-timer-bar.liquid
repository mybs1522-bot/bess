{% assign curr_var = product.selected_or_first_available_variant %}
{% assign var_compare = curr_var.compare_at_price | money_without_trailing_zeros %}
{% assign var_price = curr_var.price | money_without_trailing_zeros %}
{% if var_compare == blank or var_compare == '$0' %}{% assign var_compare = '$99' %}{% endif %}
{% if var_price == blank or var_price == '$0' %}{% assign var_price = '$49' %}{% endif %}

<aside 
  id="arch-top-sticky-timer" 
  class="arch-top-sticky-bar" 
  aria-label="Limited Time Flash Offer"
  onclick="handleTopTimerClick(event)"
>
  <div class="arch-top-sticky-content">
    <div class="arch-top-price-group">
      <span class="arch-top-price-cut">{{ var_compare }}</span>
      <span class="arch-top-price-active">{{ var_price }}</span>
    </div>
    <span class="arch-top-label">Offer ends in:</span>
    <div class="arch-top-clock-wrap" aria-live="polite">
      <span class="arch-top-clock-unit"><strong id="topStickyHours">07</strong><small>H</small></span><!--
      --><span class="arch-top-clock-sep">:</span><!--
      --><span class="arch-top-clock-unit"><strong id="topStickyMinutes">37</strong><small>M</small></span><!--
      --><span class="arch-top-clock-sep">:</span><!--
      --><span class="arch-top-clock-unit"><strong id="topStickySeconds">40</strong><small>S</small></span>
    </div>
  </div>
</aside>

<style>
