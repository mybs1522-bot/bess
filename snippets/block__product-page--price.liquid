<style>
    {%- unless block.settings.color contains "rgba(0,0,0,0)" -%}
    .product__price--{{block.id}} .product__price {
        color: {{block.settings.color}};
    }
    {%- endunless -%}
    
    {%- unless block.settings.newPriceColor contains "rgba(0,0,0,0)" -%}
    .product__price--{{block.id}} .product__price.product__price--sale {
        color: {{block.settings.newPriceColor}};
    }
    {%- endunless -%}
    
    {%- unless block.settings.oldPriceColor contains "rgba(0,0,0,0)" -%}
    .product__price--{{block.id}} .product__price--old {
        color: {{block.settings.oldPriceColor}};
    }
    {%- endunless -%}
    </style>
    
    {% assign current_variant = product.selected_or_first_available_variant %}
    {% assign s_type = settings.saleType | default: 'percent' %}

    {% if product.handle == '6-books-for-interior-exterior-design' %}
    <div class="product-editorial-block">
      <h2 class="pe-headline-primary">
        6 Books You Can Refer to Design<br>
        <span class="pe-highlight-beige">Best Interiors &amp; Exteriors Possible</span>
      </h2>

      <div class="pe-dash-indicator" aria-hidden="true">
        <span class="pe-dash dark"></span>
        <span class="pe-dash dark"></span>
        <span class="pe-dash dark"></span>
        <span class="pe-dash green"></span>
      </div>

      <p class="pe-subhead-tagline">
        <strong>Books to Design Kitchens, Living Spaces, Bedrooms, Washrooms, Study &amp; Exteriors</strong>
      </p>

      <div class="pe-statement-block">
        <h3 class="pe-statement-heading">
          Handmade Diagrams.<br>
          Real Dimensions.<br>
          No Guesswork. <mark class="pe-mark-yellow">No Regrets.</mark>
        </h3>
        <p class="pe-statement-lead">
          Let's be honest: designing a home is not just picking tiles and cabinets. It's <strong>the heart of your life</strong>, and one wrong decision can turn your dream home into a daily frustration.
        </p>

        <div class="pe-solution-card">
          <p class="pe-solution-eyebrow">But here's the good news:</p>
          <p class="pe-solution-text">
            We created 6 practical, step-by-step books that don't just inspire, they <span class="pe-text-orange">guide you like a</span> <span class="pe-text-green">professional designer</span>.
          </p>
        </div>
      </div>
    </div>

    <style>
    .product-editorial-block {
      margin: 8px 0 18px 0;
      text-align: center;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      box-sizing: border-box;
      width: 100%;
    }
    .sticky--container .product-editorial-block {
      display: none !important;
    }
    .pe-headline-primary {
      font-size: clamp(17px, 2.4vw, 24px);
      font-weight: 900;
      color: #0f172a;
      line-height: 1.35;
      letter-spacing: -0.025em;
      margin: 0 0 12px 0;
    }
    .pe-highlight-beige {
      display: inline-block;
      background: #fef08a;
      color: #0f172a;
      padding: 2px 10px;
      border-radius: 6px;
      margin-top: 4px;
    }
    .pe-dash-indicator {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 7px;
      margin: 12px 0;
    }
    .pe-dash {
      display: inline-block;
      width: 22px;
      height: 4px;
      border-radius: 999px;
    }
    .pe-dash.dark {
      background: #334155;
    }
    .pe-dash.green {
      background: #10b981;
    }
    .pe-subhead-tagline {
      font-size: 14px;
      font-weight: 500;
      color: #475569;
      margin: 0 0 20px 0;
      letter-spacing: -0.01em;
      line-height: 1.5;
    }
    .pe-subhead-tagline strong {
      font-size: 16px;
      font-weight: 800;
      color: #0f172a;
      display: inline-block;
      margin-bottom: 2px;
    }
    .pe-statement-block {
      margin-top: 8px;
    }
    .pe-statement-heading {
      font-size: clamp(21px, 3vw, 28px);
      font-weight: 900;
      color: #0f172a;
      line-height: 1.25;
      letter-spacing: -0.025em;
      margin: 0 0 12px 0;
    }
    .pe-mark-yellow {
      display: inline-block;
      background: #facc15;
      color: #0f172a;
      padding: 2px 10px;
      border-radius: 6px;
    }
    .pe-statement-lead {
      font-size: 14px;
      line-height: 1.55;
      color: #475569;
      max-width: 520px;
      margin: 0 auto 16px auto;
    }
    .pe-statement-lead strong {
      font-weight: 700;
      color: #0f172a;
    }
    .pe-solution-card {
      background: #fdfbf7;
      border: 1px solid #ede5d8;
      border-radius: 14px;
      padding: 14px 18px;
      max-width: 520px;
      margin: 0 auto 14px auto;
      box-shadow: 0 4px 14px rgba(0, 0, 0, 0.03);
    }
    .pe-solution-eyebrow {
      font-size: 12px;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: #0f172a;
      margin: 0 0 5px 0;
    }
    .pe-solution-text {
      font-size: 15px;
      font-weight: 800;
      color: #0f172a;
      line-height: 1.4;
      margin: 0;
    }
    .pe-text-orange {
      color: #ea580c;
    }
    .pe-text-green {
      color: #059669;
    }
    @media (max-width: 640px) {
      .pe-headline-primary {
        font-size: clamp(14px, 4.3vw, 17px);
        line-height: 1.35;
      }
      .pe-highlight-beige {
        font-size: clamp(13px, 3.9vw, 16px);
        padding: 2px 8px;
        white-space: nowrap;
      }
      .pe-statement-heading {
        font-size: 20px;
      }
      .pe-statement-lead {
        font-size: 13px;
      }
      .pe-solution-text {
        font-size: 14px;
      }
      .pe-solution-card {
        padding: 12px 14px;
      }
    }

    .product-architectural-pillars-strip {
      width: 100%;
      margin: 12px 0 16px 0;
      display: flex;
      justify-content: flex-start;
      align-items: center;
    }
    .product-architectural-pillars-img {
      width: 100%;
      max-width: 480px;
      height: auto;
      display: block;
      object-fit: contain;
    }
    @media (max-width: 640px) {
      .product-architectural-pillars-strip {
        margin: 8px 0 14px 0;
      }
      .product-architectural-pillars-img {
        max-width: 100%;
      }
    }
    </style>

    <div class="product-architectural-pillars-strip">
      <img 
        src="{{ 'architectural-4-pillars.png' | asset_url }}" 
        alt="Space Planning, Tips Tricks &amp; Ideas, History of Architecture, Don'ts and Do's"
        class="product-architectural-pillars-img"
        loading="lazy"
        width="1024"
        height="309"
      >
    </div>
    {% endif %}

    <div 
    class="product__price--holder product__price--{{block.id}}
    font__family--{{-block.settings.fontFamily}} font__size--{{-block.settings.fontSize}} 
    {% if block.settings.noMargin or noMargin %}margin__bottom--reduced{%endif-%}" {{block.shopify_attributes}}>
    {% if product.compare_at_price_min > 0 %}
    {% assign sale = true %}
    {% if current_variant.compare_at_price > 0 %}
    {% assign currsale = true %}
    {% else %}
    {% assign currsale = false %}
    {% endif %}
    {% else %}
    {% assign sale = false %}
    {% assign currsale = false %}
    {% endif %}
    {% assign doubled_compare = current_variant.price | times: 2 %}
    <span data-product-price="{{product.id}}" class="product__price product__price--sale jsPrice">
    {% if settings.currencyFormat == 'money_with_currency_format' %}
        {{ current_variant.price | money_with_currency | strip_html | replace: 'Rs. ', '₹' | replace: 'Rs.', '₹' | replace: 'Rs ', '₹' }}
    {% else %}
        {{ current_variant.price | money | strip_html | replace: 'Rs. ', '₹' | replace: 'Rs.', '₹' | replace: 'Rs ', '₹' }}
    {% endif %}
    </span>
    <span data-product-price-sale="{{product.id}}" class="product__price--old jsPrice">{{ doubled_compare | money | strip_html | replace: 'Rs. ', '₹' | replace: 'Rs.', '₹' | replace: 'Rs ', '₹' }}</span>
    {% if sale %}
    {%- unless s_type == 'none' or sale == false %}
    <span data-tag-product="{{product.id}}" data-tag-type="{{s_type}}" class="tag tag--sale {% if s_type == 'amount' %}jsPrice{% endif %}">
        {%- case s_type %}
            {% when 'percent' %}
                50% {{'general.tags.off'|t}}
            {% when 'amount' %}
                {{ doubled_compare | minus: current_variant.price | money | strip_html | replace: 'Rs. ', '₹' | replace: 'Rs.', '₹' | replace: 'Rs ', '₹' }}
            {% when 'text' %}
                {{'general.tags.sale' | t}}
        {%- endcase -%}
    </span>
    {%- endunless -%}
    {% endif %}
    </div>
    
    {% comment %}
    {% blockdef %}
    
    {% endblockdef %}
    {% endcomment %}