<style>
    {%- unless block.settings.color contains "rgba(0,0,0,0)" -%}
    .product__price--{{block.id}} .product__price {
        color: {{block.settings.color}};
    }
    {%- endunless -%}
    
    {%- unless block.settings.newPriceColor contains "rgba(0,0,0,0)" -%}
    .product__price--{{block.id}} .product__price.product__price--sale {
        color: {{block.settings.newPriceColor}};
    }
    {%- endunless -%}
    
    {%- unless block.settings.oldPriceColor contains "rgba(0,0,0,0)" -%}
    .product__price--{{block.id}} .product__price--old {
        color: {{block.settings.oldPriceColor}};
    }
    {%- endunless -%}
    </style>
    
    {% assign current_variant = product.selected_or_first_available_variant %}
    {% assign s_type = settings.saleType | default: 'percent' %}

    {% if product.handle == '6-books-for-interior-exterior-design' %}
    <div class="book-pointers-container">
      <div class="book-pointer-item">
        <span class="book-pointer-icon-wrap" aria-hidden="true">
          <svg class="book-pointer-tick-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <circle cx="12" cy="12" r="12" fill="#16a34a"/>
            <path d="M7 12.5L10.2 15.7L17 8.5" stroke="#ffffff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </span>
        <span class="book-pointer-text">A handmade visual guide to understanding home design.</span>
      </div>
      <div class="book-pointer-item">
        <span class="book-pointer-icon-wrap" aria-hidden="true">
          <svg class="book-pointer-tick-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <circle cx="12" cy="12" r="12" fill="#16a34a"/>
            <path d="M7 12.5L10.2 15.7L17 8.5" stroke="#ffffff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </span>
        <span class="book-pointer-text">Books to Design <strong>Kitchen</strong>, <strong>Washroom</strong>, <strong>Living</strong>, <strong>Bedroom</strong>, <strong>Exteriors &amp; Landscapes</strong>.</span>
      </div>
      <div class="book-pointer-item">
        <span class="book-pointer-icon-wrap" aria-hidden="true">
          <svg class="book-pointer-tick-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <circle cx="12" cy="12" r="12" fill="#16a34a"/>
            <path d="M7 12.5L10.2 15.7L17 8.5" stroke="#ffffff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </span>
        <span class="book-pointer-text">Monthly Free Updates in Book</span>
      </div>
      <div class="book-pointer-item">
        <span class="book-pointer-icon-wrap" aria-hidden="true">
          <svg class="book-pointer-tick-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
            <circle cx="12" cy="12" r="12" fill="#16a34a"/>
            <path d="M7 12.5L10.2 15.7L17 8.5" stroke="#ffffff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </span>
        <span class="book-pointer-text">Handmade Diagrams to explain everything clearly</span>
      </div>
    </div>

    <style>
    .book-pointers-container {
      display: flex;
      flex-direction: column;
      gap: 11px;
      margin-top: 6px;
      margin-bottom: 16px;
    }
    .book-pointer-item {
      display: flex;
      align-items: flex-start;
      gap: 12px;
    }
    .book-pointer-icon-wrap {
      flex-shrink: 0;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      margin-top: 2px;
    }
    .book-pointer-tick-icon {
      width: 20px;
      height: 20px;
      display: block;
    }
    .book-pointer-text {
      font-family: 'Space Grotesk', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      font-size: 15.5px;
      font-weight: 600;
      line-height: 1.45;
      color: #111827;
      letter-spacing: -0.01em;
    }
    .book-pointer-text strong {
      font-weight: 750;
      color: #09090b;
    }
    @media (max-width: 640px) {
      .product__review-stars {
        margin-bottom: 2px !important;
      }
      .book-editorial-rating-wrapper {
        margin-bottom: 6px !important;
      }
      .book-pointers-container {
        gap: 10px;
        margin-top: 6px;
        margin-bottom: 14px;
      }
      .book-pointer-item {
        gap: 10px;
      }
      .book-pointer-text {
        font-size: 14.5px !important;
        line-height: 1.4 !important;
      }
      .book-pointer-tick-icon {
        width: 19px;
        height: 19px;
      }
    }
    </style>
    {% endif %}

    <div 
    class="product__price--holder product__price--{{block.id}}
    font__family--{{-block.settings.fontFamily}} font__size--{{-block.settings.fontSize}} 
    {% if block.settings.noMargin or noMargin %}margin__bottom--reduced{%endif-%}" {{block.shopify_attributes}}>
    {% if product.compare_at_price_min > 0 %}
    {% assign sale = true %}
    {% if current_variant.compare_at_price > 0 %}
    {% assign currsale = true %}
    {% else %}
    {% assign currsale = false %}
    {% endif %}
    {% else %}
    {% assign sale = false %}
    {% assign currsale = false %}
    {% endif %}
    <span data-product-price="{{product.id}}" class="product__price {% if currsale %}{% unless current_variant.price >= current_variant.compare_at_price %}product__price--sale{% endunless %}{% endif %} jsPrice">
    {% if settings.currencyFormat == 'money_with_currency_format' %}
        {{ current_variant.price | money_with_currency | strip_html }}
    {% else %}
        {{ current_variant.price | money | strip_html }}
    {% endif %}
    </span>
    {% unless current_variant.price >= current_variant.compare_at_price %}
        <span data-product-price-sale="{{product.id}}" class="product__price--old jsPrice">{% if currsale %}{{ current_variant.compare_at_price | money | strip_html }}{% endif %}</span>
    {% if sale %}
    {%- unless s_type == 'none' or sale == false %}
    <span data-tag-product="{{product.id}}" data-tag-type="{{s_type}}" class="tag tag--sale {% unless currsale %}hide{% endunless %} {% if s_type == 'amount' %}jsPrice{% endif %}">
    {% if currsale %}
        {%- case s_type %}
            {% when 'percent' %}
                {{ current_variant.price | minus: current_variant.compare_at_price | times: 100 | divided_by: current_variant.compare_at_price }}% {{'general.tags.off'|t}}
            {% when 'amount' %}
                {{ current_variant.compare_at_price | minus: current_variant.price | money | strip_html }}
            {% when 'text' %}
                {{'general.tags.sale' | t}}
        {%- endcase -%}
    {% endif %}
    </span>
    {%- endunless -%}
    {% endif %}
    {% endunless %}
    </div>
    
    {% comment %}
    {% blockdef %}
    
    {% endblockdef %}
    {% endcomment %}