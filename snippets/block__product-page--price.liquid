<style>
    {%- unless block.settings.color contains "rgba(0,0,0,0)" -%}
    .product__price--{{block.id}} .product__price {
        color: {{block.settings.color}};
    }
    {%- endunless -%}
    
    {%- unless block.settings.newPriceColor contains "rgba(0,0,0,0)" -%}
    .product__price--{{block.id}} .product__price.product__price--sale {
        color: {{block.settings.newPriceColor}};
    }
    {%- endunless -%}
    
    {%- unless block.settings.oldPriceColor contains "rgba(0,0,0,0)" -%}
    .product__price--{{block.id}} .product__price--old {
        color: {{block.settings.oldPriceColor}};
    }
    {%- endunless -%}
    </style>
    
    {% assign current_variant = product.selected_or_first_available_variant %}
    {% assign s_type = settings.saleType | default: 'percent' %}

    {% if product.handle == '6-books-for-interior-exterior-design' %}
    <div class="book-pointers-container">
      <div class="book-pointer-item">
        <span class="book-pointer-icon-wrap" aria-hidden="true">
          <svg class="book-pointer-tick-icon" width="20" height="20" viewBox="0 0 24 24" fill="none">
            <circle cx="12" cy="12" r="10" fill="#ecfdf5" stroke="#10b981" stroke-width="1.5"/>
            <path d="M8 12.2L10.8 15L16 9.5" stroke="#059669" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </span>
        <span class="book-pointer-text"><strong>Handmade Visual Standards:</strong> Over 800 hand-drawn blueprints, ergonomic clearances, and interior dimensions.</span>
      </div>
      <div class="book-pointer-item">
        <span class="book-pointer-icon-wrap" aria-hidden="true">
          <svg class="book-pointer-tick-icon" width="20" height="20" viewBox="0 0 24 24" fill="none">
            <circle cx="12" cy="12" r="10" fill="#ecfdf5" stroke="#10b981" stroke-width="1.5"/>
            <path d="M8 12.2L10.8 15L16 9.5" stroke="#059669" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </span>
        <span class="book-pointer-text"><strong>Comprehensive 6-Volume Set:</strong> Dedicated editions for <strong>Kitchens</strong>, <strong>Bathrooms</strong>, <strong>Living Spaces</strong>, <strong>Bedrooms</strong>, and <strong>Landscapes</strong>.</span>
      </div>
      <div class="book-pointer-item">
        <span class="book-pointer-icon-wrap" aria-hidden="true">
          <svg class="book-pointer-tick-icon" width="20" height="20" viewBox="0 0 24 24" fill="none">
            <circle cx="12" cy="12" r="10" fill="#ecfdf5" stroke="#10b981" stroke-width="1.5"/>
            <path d="M8 12.2L10.8 15L16 9.5" stroke="#059669" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </span>
        <span class="book-pointer-text"><strong>Site-Ready Practical Execution:</strong> Real-world dimensional rules and exact layouts to eliminate costly contractor mistakes.</span>
      </div>
      <div class="book-pointer-item">
        <span class="book-pointer-icon-wrap" aria-hidden="true">
          <svg class="book-pointer-tick-icon" width="20" height="20" viewBox="0 0 24 24" fill="none">
            <circle cx="12" cy="12" r="10" fill="#ecfdf5" stroke="#10b981" stroke-width="1.5"/>
            <path d="M8 12.2L10.8 15L16 9.5" stroke="#059669" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </span>
        <span class="book-pointer-text"><strong>Free Lifetime Updates:</strong> Receive all upcoming monthly volume additions, revisions, and instant digital access.</span>
      </div>
    </div>

    <style>
    .book-pointers-container {
      display: flex;
      flex-direction: column;
      gap: 12px;
      margin-top: 8px;
      margin-bottom: 18px;
    }
    .book-pointer-item {
      display: flex;
      align-items: flex-start;
      gap: 11px;
    }
    .book-pointer-icon-wrap {
      flex-shrink: 0;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      margin-top: 2px;
    }
    .book-pointer-tick-icon {
      width: 20px;
      height: 20px;
      display: block;
      filter: drop-shadow(0 1px 2px rgba(5, 150, 105, 0.12));
    }
    .book-pointer-text {
      font-family: 'Space Grotesk', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      font-size: 14.5px;
      font-weight: 500;
      line-height: 1.48;
      color: #374151;
      letter-spacing: -0.01em;
    }
    .book-pointer-text strong {
      font-weight: 700;
      color: #111827;
    }
    @media (max-width: 640px) {
      .product__review-stars {
        margin-bottom: 2px !important;
      }
      .book-editorial-rating-wrapper {
        margin-bottom: 6px !important;
      }
      .book-pointers-container {
        gap: 10px;
        margin-top: 6px;
        margin-bottom: 15px;
      }
      .book-pointer-item {
        gap: 10px;
      }
      .book-pointer-text {
        font-size: 13.5px !important;
        line-height: 1.42 !important;
      }
      .book-pointer-tick-icon {
        width: 18px;
        height: 18px;
      }
    }

    .product-architectural-pillars-strip {
      width: 100%;
      margin: 12px 0 16px 0;
      display: flex;
      justify-content: flex-start;
      align-items: center;
    }
    .product-architectural-pillars-img {
      width: 100%;
      max-width: 480px;
      height: auto;
      display: block;
      object-fit: contain;
    }
    @media (max-width: 640px) {
      .product-architectural-pillars-strip {
        margin: 8px 0 14px 0;
      }
      .product-architectural-pillars-img {
        max-width: 100%;
      }
    }
    </style>

    <div class="product-architectural-pillars-strip">
      <img 
        src="{{ 'architectural-4-pillars.png' | asset_url }}" 
        alt="Space Planning, Tips Tricks &amp; Ideas, History of Architecture, Don'ts and Do's"
        class="product-architectural-pillars-img"
        loading="lazy"
        width="1024"
        height="309"
      >
    </div>
    {% endif %}

    <div 
    class="product__price--holder product__price--{{block.id}}
    font__family--{{-block.settings.fontFamily}} font__size--{{-block.settings.fontSize}} 
    {% if block.settings.noMargin or noMargin %}margin__bottom--reduced{%endif-%}" {{block.shopify_attributes}}>
    {% if product.compare_at_price_min > 0 %}
    {% assign sale = true %}
    {% if current_variant.compare_at_price > 0 %}
    {% assign currsale = true %}
    {% else %}
    {% assign currsale = false %}
    {% endif %}
    {% else %}
    {% assign sale = false %}
    {% assign currsale = false %}
    {% endif %}
    {% assign doubled_compare = current_variant.price | times: 2 %}
    <span data-product-price="{{product.id}}" class="product__price product__price--sale jsPrice">
    {% if settings.currencyFormat == 'money_with_currency_format' %}
        {{ current_variant.price | money_with_currency | strip_html | replace: 'Rs. ', '₹' | replace: 'Rs.', '₹' | replace: 'Rs ', '₹' }}
    {% else %}
        {{ current_variant.price | money | strip_html | replace: 'Rs. ', '₹' | replace: 'Rs.', '₹' | replace: 'Rs ', '₹' }}
    {% endif %}
    </span>
    <span data-product-price-sale="{{product.id}}" class="product__price--old jsPrice">{{ doubled_compare | money | strip_html | replace: 'Rs. ', '₹' | replace: 'Rs.', '₹' | replace: 'Rs ', '₹' }}</span>
    {% if sale %}
    {%- unless s_type == 'none' or sale == false %}
    <span data-tag-product="{{product.id}}" data-tag-type="{{s_type}}" class="tag tag--sale {% if s_type == 'amount' %}jsPrice{% endif %}">
        {%- case s_type %}
            {% when 'percent' %}
                50% {{'general.tags.off'|t}}
            {% when 'amount' %}
                {{ doubled_compare | minus: current_variant.price | money | strip_html | replace: 'Rs. ', '₹' | replace: 'Rs.', '₹' | replace: 'Rs ', '₹' }}
            {% when 'text' %}
                {{'general.tags.sale' | t}}
        {%- endcase -%}
    </span>
    {%- endunless -%}
    {% endif %}
    </div>
    
    {% comment %}
    {% blockdef %}
    
    {% endblockdef %}
    {% endcomment %}