      };

      var currentHandle = {{ product.handle | json }};
      var ALL_REVIEWS = REVIEWS_BY_HANDLE[currentHandle] || REVIEWS_BY_HANDLE['default'];

      var PAGE_SIZE = 6;
      var currentPage = 1;
      var currentSort = 'recent';
      var activeReviews = ALL_REVIEWS.slice();

      function getInitials(name) {
        if (!name) return 'A';
        var parts = name.split(' ');
        if (parts.length >= 2) {
          return parts[0][0] + parts[1][0];
        }
        return name.slice(0, 2).toUpperCase();
      }

      function renderStars(rating) {
        var str = '';
        for (var i = 0; i < 5; i++) {
          if (i < rating) {
            str += '★';
          } else {
            str += '☆';
          }
        }
        return str;
      }

      function renderReviews() {
        var container = document.getElementById('bstrReviewsContainer');
        var headerCount = document.getElementById('bstrRevHeaderCount');
        if (!container) return;

        var total = activeReviews.length;
        var startIdx = (currentPage - 1) * PAGE_SIZE;
        var endIdx = Math.min(startIdx + PAGE_SIZE, total);
        var pageItems = activeReviews.slice(startIdx, endIdx);

        if (headerCount) {
          headerCount.textContent = 'Showing ' + (total === 0 ? '0' : (startIdx + 1) + '–' + endIdx) + ' of ' + total + ' Reviews';
        }

        var html = '';
        for (var i = 0; i < pageItems.length; i++) {
          var r = pageItems[i];
          var editionBadge = r.ed === 1 ? 'Hardcopy Master Collection' : 'Digital Edition (PDF)';
          var starsHtml = renderStars(r.s);
          var initials = getInitials(r.name);

          html += '<article class="bstr-rev-card">' +
            '<div class="bstr-rev-card-header">' +
              '<div class="bstr-rev-author-info">' +
                '<div class="bstr-rev-avatar">' + initials + '</div>' +
                '<div>' +
                  '<div class="bstr-rev-author-name">' +
                    r.name +
                    '<span class="bstr-rev-verified-pill">' +
                      '<svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>' +
                      'Verified Purchase' +
                    '</span>' +
                  '</div>' +
                  '<div class="bstr-rev-meta">' + r.loc + ' • Verified Reader</div>' +
                '</div>' +
              '</div>' +
              '<div style="text-align: right;">' +
                '<div class="bstr-rev-stars-item">' + starsHtml + '</div>' +
                '<div class="bstr-rev-meta">' + r.d + '</div>' +
              '</div>' +
            '</div>' +
            '<h4 class="bstr-rev-title">' + r.t + '</h4>' +
            '<p class="bstr-rev-body">' + r.b + '</p>' +
            '<div class="bstr-rev-footer">' +
              '<div>Purchased: <strong>' + editionBadge + '</strong></div>' +
              '<button class="bstr-rev-helpful-btn" onclick="bstrHelpful(this, ' + r.h + ')">' +
                '<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 9V5a3 3 0 0 0-3-3l-4 9v11h11.28a2 2 0 0 0 2-1.7l1.38-9a2 2 0 0 0-2-2.3zM7 22H4a2 2 0 0 1-2-2v-7a2 2 0 0 1 2-2h3"></path></svg>' +
                'Helpful (' + r.h + ')' +
              '</button>' +
            '</div>' +
          '</article>';
        }

        container.innerHTML = html;
        renderPagination();
      }

      function renderPagination() {
        var pag = document.getElementById('bstrRevPagination');
        if (!pag) return;

        var totalPages = Math.ceil(activeReviews.length / PAGE_SIZE);
        if (totalPages <= 1) {
          pag.innerHTML = '';
          return;
        }

        var html = '';
        html += '<button class="bstr-rev-page-btn" ' + (currentPage === 1 ? 'disabled' : '') + ' onclick="bstrGoPage(' + (currentPage - 1) + ')">‹ Prev</button>';

        var maxButtons = 5;
        var startPage = Math.max(1, currentPage - 2);
        var endPage = Math.min(totalPages, startPage + maxButtons - 1);
        if (endPage - startPage < maxButtons - 1) {
          startPage = Math.max(1, endPage - maxButtons + 1);
        }

        if (startPage > 1) {
          html += '<button class="bstr-rev-page-btn" onclick="bstrGoPage(1)">1</button>';
          if (startPage > 2) {
            html += '<span class="bstr-rev-dots">...</span>';
          }
        }

        for (var p = startPage; p <= endPage; p++) {
          var activeClass = (p === currentPage) ? ' active' : '';
          html += '<button class="bstr-rev-page-btn' + activeClass + '" onclick="bstrGoPage(' + p + ')">' + p + '</button>';
        }

        if (endPage < totalPages) {
          if (endPage < totalPages - 1) {
            html += '<span class="bstr-rev-dots">...</span>';
          }
          html += '<button class="bstr-rev-page-btn" onclick="bstrGoPage(' + totalPages + ')">' + totalPages + '</button>';
        }

        html += '<button class="bstr-rev-page-btn" ' + (currentPage === totalPages ? 'disabled' : '') + ' onclick="bstrGoPage(' + (currentPage + 1) + ')">Next ›</button>';
        pag.innerHTML = html;
      }

      window.bstrGoPage = function(page) {
        currentPage = page;
        renderReviews();
        var comp = document.getElementById('bstr-reviews-component');
        if (comp) {
          comp.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      };

      window.bstrChangeSort = function(val) {
        currentSort = val;
        currentPage = 1;
        if (val === 'highest') {
          activeReviews.sort(function(a, b) {
            return b.s - a.s;
          });
        } else {
          activeReviews = ALL_REVIEWS.slice();
        }
        renderReviews();
      };

      window.bstrHelpful = function(btn, count) {
        btn.innerHTML = '<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 9V5a3 3 0 0 0-3-3l-4 9v11h11.28a2 2 0 0 0 2-1.7l1.38-9a2 2 0 0 0-2-2.3zM7 22H4a2 2 0 0 1-2-2v-7a2 2 0 0 1 2-2h3"></path></svg> Helpful (' + (count + 1) + ')';
        btn.disabled = true;
        btn.style.color = '#ea580c';
        btn.style.borderColor = '#ea580c';
      };

      renderReviews();
    })();
  </script>
</div>
