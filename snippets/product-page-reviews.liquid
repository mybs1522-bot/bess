<div id="bstr-reviews-component" class="bstr-rev-root">
  <style>
    .bstr-rev-root {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif !important;
      color: #111827 !important;
      padding: 10px 0 50px;
      max-width: 1080px;
      margin: 0 auto;
    }

    .bstr-rev-root * {
      box-sizing: border-box;
    }

    /* Overall Summary Card */
    .bstr-rev-summary {
      background: linear-gradient(180deg, #ffffff 0%, #fafafa 100%);
      border: 1px solid #e5e7eb;
      border-radius: 20px;
      padding: 36px 40px;
      display: flex;
      gap: 48px;
      align-items: center;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.03);
      margin-bottom: 36px;
    }

    @media (max-width: 768px) {
      .bstr-rev-summary {
        flex-direction: column;
        padding: 24px 20px;
        gap: 28px;
        text-align: center;
      }
    }

    .bstr-rev-score-col {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      min-width: 200px;
      border-right: 1px solid #f3f4f6;
      padding-right: 40px;
    }

    @media (max-width: 768px) {
      .bstr-rev-score-col {
        border-right: none;
        border-bottom: 1px solid #f3f4f6;
        padding-right: 0;
        padding-bottom: 24px;
        align-items: center;
        width: 100%;
      }
    }

    .bstr-rev-big-num {
      font-size: 54px !important;
      font-weight: 900 !important;
      line-height: 1 !important;
      color: #09090b !important;
      letter-spacing: -0.03em;
    }

    .bstr-rev-gold-stars {
      color: #ea580c !important;
      font-size: 20px !important;
      letter-spacing: 2px;
      margin: 8px 0 4px;
    }

    .bstr-rev-count-badge {
      font-size: 13px !important;
      color: #4b5563 !important;
      font-weight: 700;
    }

    .bstr-rev-recommend-tag {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      margin-top: 10px;
      font-size: 11px !important;
      font-weight: 700 !important;
      color: #059669 !important;
      background: #ecfdf5 !important;
      padding: 4px 10px;
      border-radius: 9999px;
      border: 1px solid #a7f3d0;
    }

    /* Breakdown Bars */
    .bstr-rev-bars-col {
      flex: 1;
      width: 100%;
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .bstr-rev-bar-row {
      display: flex;
      align-items: center;
      gap: 12px;
      font-size: 13px !important;
      font-weight: 600 !important;
      color: #4b5563 !important;
    }

    .bstr-rev-bar-label {
      width: 52px;
      text-align: right;
      flex-shrink: 0;
    }

    .bstr-rev-bar-track {
      flex: 1;
      height: 9px;
      background: #e5e7eb;
      border-radius: 9999px;
      overflow: hidden;
      position: relative;
    }

    .bstr-rev-bar-fill {
      height: 100%;
      background: linear-gradient(90deg, #f59e0b 0%, #ea580c 100%);
      border-radius: 9999px;
    }

    .bstr-rev-bar-pct {
      width: 38px;
      font-size: 12px !important;
      color: #6b7280 !important;
      flex-shrink: 0;
    }

    /* Filter & Header Bar */
    .bstr-rev-controls-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 24px;
      padding-bottom: 16px;
      border-bottom: 1px solid #f3f4f6;
      flex-wrap: wrap;
      gap: 12px;
    }

    .bstr-rev-total-label {
      font-size: 18px !important;
      font-weight: 800 !important;
      color: #111827 !important;
    }

    .bstr-rev-sort-select {
      border: 1px solid #d1d5db;
      background-color: #ffffff;
      padding: 8px 14px;
      border-radius: 10px;
      font-size: 13px;
      color: #374151;
      font-weight: 600;
      cursor: pointer;
    }

    /* Reviews List */
    .bstr-rev-list {
      display: flex;
      flex-direction: column;
      gap: 16px;
    }

    .bstr-rev-card {
      background: #ffffff;
      border: 1px solid #e5e7eb;
      border-radius: 16px;
      padding: 24px 28px;
      transition: all 0.2s ease;
      box-shadow: 0 2px 6px rgba(0,0,0,0.02);
    }

    .bstr-rev-card:hover {
      border-color: #fed7aa;
      box-shadow: 0 8px 20px -6px rgba(0,0,0,0.06);
    }

    @media (max-width: 640px) {
      .bstr-rev-card {
        padding: 18px 16px;
      }
    }

    .bstr-rev-card-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      margin-bottom: 12px;
      flex-wrap: wrap;
      gap: 8px;
    }

    .bstr-rev-author-info {
      display: flex;
      align-items: center;
      gap: 14px;
    }

    .bstr-rev-avatar {
      width: 44px;
      height: 44px;
      border-radius: 50%;
      background: linear-gradient(135deg, #ffedd5 0%, #fed7aa 100%);
      color: #ea580c !important;
      font-weight: 800;
      font-size: 15px;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      border: 1px solid #fdba74;
    }

    .bstr-rev-author-name {
      font-size: 15px !important;
      font-weight: 800 !important;
      color: #111827 !important;
      display: flex;
      align-items: center;
      gap: 6px;
      flex-wrap: wrap;
    }

    .bstr-rev-verified-pill {
      display: inline-flex;
      align-items: center;
      gap: 3px;
      font-size: 11px !important;
      font-weight: 700 !important;
      color: #059669 !important;
      background: #ecfdf5 !important;
      padding: 2px 8px;
      border-radius: 9999px;
      border: 1px solid #a7f3d0;
    }

    .bstr-rev-meta {
      font-size: 12px !important;
      color: #6b7280 !important;
      margin-top: 2px;
    }

    .bstr-rev-stars-item {
      color: #ea580c !important;
      font-size: 15px !important;
      letter-spacing: 1px;
    }

    .bstr-rev-title {
      font-size: 16px !important;
      font-weight: 800 !important;
      color: #111827 !important;
      margin: 6px 0 8px !important;
      line-height: 1.35;
    }

    .bstr-rev-body {
      font-size: 14px !important;
      line-height: 1.65 !important;
      color: #374151 !important;
      margin: 0 0 14px !important;
    }

    .bstr-rev-footer {
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 12px !important;
      color: #9ca3af !important;
      border-top: 1px solid #f9fafb;
      padding-top: 12px;
    }

    .bstr-rev-helpful-btn {
      background: none;
      border: 1px solid #e5e7eb;
      padding: 4px 10px;
      border-radius: 6px;
      font-size: 12px;
      color: #6b7280;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 4px;
      transition: all 0.2s ease;
    }

    .bstr-rev-helpful-btn:hover {
      background: #f9fafb;
      color: #111827;
      border-color: #d1d5db;
    }

    /* Pagination */
    .bstr-rev-pagination {
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 8px;
      margin-top: 40px;
      flex-wrap: wrap;
    }

    .bstr-rev-page-btn {
      min-width: 40px;
      height: 40px;
      padding: 0 12px;
      border-radius: 12px;
      background: #ffffff;
      border: 1px solid #e5e7eb;
      font-size: 13px !important;
      font-weight: 700 !important;
      color: #374151 !important;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      transition: all 0.2s ease;
    }

    .bstr-rev-page-btn:hover:not(:disabled) {
      background: #f9fafb;
      border-color: #ea580c;
      color: #ea580c !important;
    }

    .bstr-rev-page-btn.active {
      background: #ea580c !important;
      border-color: #ea580c !important;
      color: #ffffff !important;
      box-shadow: 0 4px 12px rgba(234, 88, 12, 0.3);
    }

    .bstr-rev-page-btn:disabled {
      opacity: 0.4;
      cursor: not-allowed;
    }

    .bstr-rev-dots {
      padding: 0 4px;
      color: #9ca3af;
      font-weight: 700;
    }
  </style>

  <!-- Summary Card -->
  <div class="bstr-rev-summary">
    <div class="bstr-rev-score-col">
      <div class="bstr-rev-big-num">{{ avg_score }}</div>
      <div class="bstr-rev-gold-stars">★★★★★</div>
      <div class="bstr-rev-count-badge">Based on {{ rating_count }} Ratings</div>
      <div class="bstr-rev-recommend-tag">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
        98% recommend this
      </div>
    </div>

    <div class="bstr-rev-bars-col">
      <div class="bstr-rev-bar-row">
        <span class="bstr-rev-bar-label">5 Star</span>
        <div class="bstr-rev-bar-track"><div class="bstr-rev-bar-fill" style="width: {{ five_pct }};"></div></div>
        <span class="bstr-rev-bar-pct">{{ five_pct }}</span>
      </div>
      <div class="bstr-rev-bar-row">
        <span class="bstr-rev-bar-label">4 Star</span>
        <div class="bstr-rev-bar-track"><div class="bstr-rev-bar-fill" style="width: {{ four_pct }};"></div></div>
        <span class="bstr-rev-bar-pct">{{ four_pct }}</span>
      </div>
      <div class="bstr-rev-bar-row">
        <span class="bstr-rev-bar-label">3 Star</span>
        <div class="bstr-rev-bar-track"><div class="bstr-rev-bar-fill" style="width: {{ three_pct }};"></div></div>
        <span class="bstr-rev-bar-pct">{{ three_pct }}</span>
      </div>
      <div class="bstr-rev-bar-row">
        <span class="bstr-rev-bar-label">2 Star</span>
        <div class="bstr-rev-bar-track"><div class="bstr-rev-bar-fill" style="width: 0%;"></div></div>
        <span class="bstr-rev-bar-pct">0%</span>
      </div>
      <div class="bstr-rev-bar-row">
        <span class="bstr-rev-bar-label">1 Star</span>
        <div class="bstr-rev-bar-track"><div class="bstr-rev-bar-fill" style="width: 0%;"></div></div>
        <span class="bstr-rev-bar-pct">0%</span>
      </div>
    </div>
  </div>

  <!-- Header Controls -->
  <div class="bstr-rev-controls-bar">
    <div class="bstr-rev-total-label" id="bstrRevHeaderCount">Showing 1–6 of {{ review_count }} Reviews</div>
    <div>
      <select class="bstr-rev-sort-select" onchange="bstrChangeSort(this.value)">
        <option value="recent">Most Recent</option>
        <option value="highest">Highest Rating</option>
      </select>
    </div>
  </div>

  <!-- Reviews Container -->
  <div class="bstr-rev-list" id="bstrReviewsContainer">
    <!-- Populated by JavaScript -->
  </div>

  <!-- Pagination Controls -->
  <div class="bstr-rev-pagination" id="bstrRevPagination">
    <!-- Populated by JavaScript -->
  </div>

