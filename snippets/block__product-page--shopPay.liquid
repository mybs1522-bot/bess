<div class="product__shoppay-installments {% if block.settings.noMargin or noMargin %}margin__bottom--reduced{%endif-%}" {{block.shopify_attributes}}>
  {{ form | payment_terms }}
</div>

<script>
(function() {
  function forceSingleLinePaymentTerms() {
    var pts = document.querySelectorAll('shopify-payment-terms');
    pts.forEach(function(pt) {
      if (pt && pt.shadowRoot) {
        if (!pt.shadowRoot.querySelector('#single-line-shop-pay-css')) {
          var style = document.createElement('style');
          style.id = 'single-line-shop-pay-css';
          style.textContent = `
            #shopify-installments,
            #shopify-installments p {
              white-space: nowrap !important;
              display: inline-flex !important;
              align-items: center !important;
              flex-wrap: nowrap !important;
              font-size: clamp(10px, 3.1vw, 13px) !important;
              letter-spacing: -0.015em !important;
              line-height: 1.2 !important;
              margin: 0 !important;
            }
            #shopify-installments-content {
              white-space: nowrap !important;
              flex-shrink: 0 !important;
            }
            #shopify-installments-cta {
              display: inline-flex !important;
              align-items: center !important;
              white-space: nowrap !important;
              flex-shrink: 0 !important;
              margin-left: 3px !important;
            }
            @media (max-width: 480px) {
              #shopify-installments,
              #shopify-installments p {
                font-size: 11px !important;
                letter-spacing: -0.025em !important;
              }
            }
            @media (max-width: 360px) {
              #shopify-installments,
              #shopify-installments p {
                font-size: 9.6px !important;
                letter-spacing: -0.03em !important;
              }
            }
          `;
          pt.shadowRoot.appendChild(style);
        }
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', forceSingleLinePaymentTerms);
  } else {
    forceSingleLinePaymentTerms();
  }

  var observer = new MutationObserver(forceSingleLinePaymentTerms);
  observer.observe(document.body, { childList: true, subtree: true });

  var attempts = 0;
  var timer = setInterval(function() {
    forceSingleLinePaymentTerms();
    attempts++;
    if (attempts > 30) clearInterval(timer);
  }, 150);
})();
</script>