      var activeCurrIndex = 0;
      var currPaused = false;

      function renderCurriculum(index) {
        activeCurrIndex = (index + curriculumData.length) % curriculumData.length;
        var book = curriculumData[activeCurrIndex];

        var tabBtns = document.querySelectorAll('#lp6CurrTabs .lp6-curr-tab-btn');
        tabBtns.forEach(function(b, i) {
          if (i === activeCurrIndex) b.classList.add('active');
          else b.classList.remove('active');
        });

        var titleEl = document.getElementById('lp6CurrTitle');
        var imgEl = document.getElementById('lp6CurrImg');
        var gridEl = document.getElementById('lp6CurrGrid');

        if (titleEl) titleEl.innerText = book.title;
        if (imgEl) imgEl.src = book.img;

        if (gridEl) {
          var html = '';
          book.sections.forEach(function(sec) {
            html += '<div>';
            html += '  <div class="lp6-curr-sec-title">' + sec.name + '</div>';
            html += '  <ul class="lp6-curr-list">';
            sec.items.forEach(function(item) {
              html += '    <li>';
              html += '      <svg class="lp6-check-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>';
              html += '      <span>' + item + '</span>';
              html += '    </li>';
            });
            html += '  </ul>';
            html += '</div>';
          });
          gridEl.innerHTML = html;
        }
      }

      window.lp6SelectCurriculum = function(index) {
        renderCurriculum(index);
        currPaused = true;
        setTimeout(function() { currPaused = false; }, 8000);
      };

      // Initial render
      renderCurriculum(0);

      // Auto cycle every 4s unless paused
      setInterval(function() {
        if (!currPaused) {
          renderCurriculum(activeCurrIndex + 1);
        }
      }, 4000);

      // 3. CTA Add to Cart Functions
      var EBOOK_VARIANT_ID = 53066848436541;
      var HARDCOPY_VARIANT_ID = 53066848469309;

      function triggerCartAdd(variantId, btn) {
        var origHtml = btn ? btn.innerHTML : '';
        if (btn) {
          btn.innerHTML = 'Adding to cart...';
          btn.style.opacity = '0.7';
          btn.style.pointerEvents = 'none';
        }

        // Try BoosterTheme native cart first
        if (window.BoosterTheme && window.BoosterTheme.cart && typeof window.BoosterTheme.cart.addToCartJSON === 'function') {
          window.BoosterTheme.cart.addToCartJSON(false, {
            items: [{ id: variantId, quantity: 1 }]
          });
          setTimeout(function() {
            if (btn) {
              btn.innerHTML = origHtml;
              btn.style.opacity = '1';
              btn.style.pointerEvents = 'auto';
            }
          }, 800);
          return;
        }

        // Fallback: standard Shopify Cart API
        fetch('/cart/add.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ id: variantId, quantity: 1 })
        })
        .then(function(res) { return res.json(); })
        .then(function(data) {
          if (btn) {
            btn.innerHTML = origHtml;
            btn.style.opacity = '1';
            btn.style.pointerEvents = 'auto';
          }
          if (window.BoosterTheme && window.BoosterTheme.cart && typeof window.BoosterTheme.cart.open === 'function') {
            window.BoosterTheme.cart.open();
          } else {
            window.location.href = '/cart';
          }
        })
        .catch(function(err) {
          console.error(err);
          if (btn) {
            btn.innerHTML = origHtml;
            btn.style.opacity = '1';
            btn.style.pointerEvents = 'auto';
          }
          window.location.href = '/cart';
        });
      }

      window.lp6AddEbook = function(btn) {
        var ebookInput = document.querySelector('input[data-bstr-swatch-val="E-book"], input[value="E-book"]');
        if (ebookInput) {
          ebookInput.checked = true;
          ebookInput.dispatchEvent(new Event('change', { bubbles: true }));
        }
        triggerCartAdd(EBOOK_VARIANT_ID, btn);
      };

      window.lp6AddHardcopy = function(btn) {
        var hardcopyInput = document.querySelector('input[data-bstr-swatch-val="Hardcopy"], input[value="Hardcopy"]');
        if (hardcopyInput) {
          hardcopyInput.checked = true;
          hardcopyInput.dispatchEvent(new Event('change', { bubbles: true }));
        }
        triggerCartAdd(HARDCOPY_VARIANT_ID, btn);
      };

    })();
  </script>
