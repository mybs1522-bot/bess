      ]
    }
  ];

  var activeIndex = 0;

  window.lp6SelectCurriculum = function(index) {
    activeIndex = (index + curriculumData.length) % curriculumData.length;
    var book = curriculumData[activeIndex];

    var tabBtns = document.querySelectorAll('#lp6CurrTabs .lp6-curr-tab-btn');
    tabBtns.forEach(function(btn, i) {
      if (i === activeIndex) btn.classList.add('active');
      else btn.classList.remove('active');
    });

    var titleEl = document.getElementById('lp6CurrTitle');
    var imgEl = document.getElementById('lp6CurrImg');
    var gridEl = document.getElementById('lp6CurrGrid');

    if (titleEl) titleEl.textContent = book.title;
    if (imgEl) imgEl.src = book.img;

    if (gridEl) {
      var html = '';
      book.sections.forEach(function(sec) {
        html += '<div class="lp6-curr-sec-col">';
        html += '  <div class="lp6-curr-sec-title">' + sec.name + '</div>';
